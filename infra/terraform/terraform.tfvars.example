# =============================================================================
# PharmaForge OS — Terraform Variables Example
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it is gitignored.
#
# Secrets should be passed via environment variables instead:
#   export TF_VAR_db_password="your-strong-password"
#   export TF_VAR_secret_key="your-64-char-random-secret-key"
#   export TF_VAR_openai_api_key="sk-..."        # optional
#   export TF_VAR_anthropic_api_key="sk-ant-..."  # optional
# =============================================================================

# --- General ---
environment = "staging"
aws_region  = "us-east-1"

# --- Networking ---
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# --- Database (RDS PostgreSQL 15) ---
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
# db_password — set via TF_VAR_db_password

# --- Redis (ElastiCache 7.x) ---
redis_node_type = "cache.t3.micro"

# --- App (ECS Fargate) ---
app_cpu           = 512   # 0.5 vCPU
app_memory        = 1024  # 1 GB
app_desired_count = 2

# --- Secrets (set via environment variables, NOT here) ---
# secret_key       — TF_VAR_secret_key (min 32 chars)
# openai_api_key   — TF_VAR_openai_api_key (optional)
# anthropic_api_key — TF_VAR_anthropic_api_key (optional)
